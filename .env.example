# Copier vers .env.local — ne jamais committer de vraies valeurs.
NODE_ENV=development
APP_ENV=dev
APP_URL=http://localhost:3000

# Trois rôles Postgres distincts (voir packages/db/prisma/migrations/*_rls_and_roles)
DATABASE_URL=postgresql://mai_app:CHANGE_ME@localhost:5432/mai_dev          # soumis à la RLS (web)
DATABASE_SERVICE_URL=postgresql://mai_service:CHANGE_ME@localhost:5432/mai_dev # worker / webhooks / admin
DATABASE_ADMIN_URL=postgresql://owner:CHANGE_ME@localhost:5432/mai_dev      # migrations uniquement

REDIS_URL=redis://localhost:6379

# Secrets (générer : openssl rand -base64 48 / openssl rand -base64 32)
AUTH_SECRET=
KEK_BASE64=
KEK_VERSION=1
HASH_PEPPER=

# Services externes (obligatoires en production)
RESEND_API_KEY=
EMAIL_FROM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO_MONTH=     # identifiants de prix Stripe (price_…)
STRIPE_PRICE_SOLO_YEAR=
STRIPE_PRICE_FAMILLE_MONTH=
STRIPE_PRICE_FAMILLE_YEAR=
OPENAI_API_KEY=
AI_PROVIDER=            # openai | fake (fake réservé à APP_ENV=dev)
AI_MODEL_MINI=gpt-5-mini
AI_MODEL_FULL=gpt-5
AI_PRICING_JSON=        # {"gpt-5-mini":{"inPerMTok":0,"outPerMTok":0}} (micro-euros / million de tokens, grille officielle)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TURNSTILE_SECRET_KEY=
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
